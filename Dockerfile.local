# Self-contained build from source, for local development:
#   docker build -f Dockerfile.local -t grafana-mcp-setup:dev .
# The release image (Dockerfile) instead copies a goreleaser-built binary.
FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/grafana-mcp-setup ./cmd/grafana-mcp-setup

FROM gcr.io/distroless/static:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931

COPY --from=build /out/grafana-mcp-setup /grafana-mcp-setup

USER nonroot:nonroot

EXPOSE 8080

ENTRYPOINT ["/grafana-mcp-setup"]
