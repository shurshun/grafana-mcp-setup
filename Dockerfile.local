# Self-contained build from source, for local development:
#   docker build -f Dockerfile.local -t grafana-mcp-setup:dev .
# The release image (Dockerfile) instead copies a goreleaser-built binary.
FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/grafana-mcp-setup ./cmd/grafana-mcp-setup

FROM gcr.io/distroless/static:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

COPY --from=build /out/grafana-mcp-setup /grafana-mcp-setup

USER nonroot:nonroot

EXPOSE 8080

ENTRYPOINT ["/grafana-mcp-setup"]
