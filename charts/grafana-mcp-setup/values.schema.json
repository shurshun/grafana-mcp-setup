{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "allOf": [
    {
      "anyOf": [
        {"properties": {"auth": {"properties": {"mode": {"enum": ["proxy"]}}}}},
        {"properties": {"appPublicURL": {"pattern": "^https://"}}}
      ]
    }
  ],
  "properties": {
    "enableEnvSetup": {"type": "boolean"},
    "replicaCount": {"type": "integer", "minimum": 1},
    "appPublicURL": {"type": "string", "pattern": "^https?://", "minLength": 8},
    "basePath": {"type": "string", "pattern": "^/"},
    "tokenTTLDays": {"type": "integer", "minimum": 1, "maximum": 365},
    "grafana": {
      "type": "object",
      "properties": {
        "apiMode": {"enum": ["legacy", "iam"]},
        "serviceAccountToken": {
          "type": "object",
          "properties": {
            "create": {"type": "boolean"},
            "instanceName": {"type": "string"},
            "name": {"type": "string"},
            "tokenName": {"type": "string", "minLength": 1},
            "secretName": {"type": "string"}
          },
          "required": ["create", "instanceName", "name", "tokenName", "secretName"]
        }
      },
      "required": ["apiMode", "serviceAccountToken"]
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["proxy", "native"]},
        "session": {
          "type": "object",
          "properties": {
            "existingSecret": {"type": "string"},
            "existingSecretKey": {"type": "string", "minLength": 1},
            "key": {"type": "string"},
            "ttlSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          },
          "required": ["existingSecret", "existingSecretKey", "key", "ttlSeconds"]
        }
      },
      "required": ["mode", "session"]
    },
    "rotationLock": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["local", "kubernetes"]},
        "createLease": {"type": "boolean"},
        "leaseName": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
      },
      "required": ["mode", "leaseName", "createLease"]
    },
    "oidc": {
      "type": "object",
      "properties": {
        "clientSecret": {"type": "string"},
        "existingSecret": {"type": "string"},
        "existingSecretKey": {"type": "string", "minLength": 1},
        "scopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "idTokenSource": {"enum": ["header", "cookie"]},
        "idTokenHeader": {"type": "string", "minLength": 1},
        "idTokenCookie": {"type": "string", "minLength": 1},
        "requiredGroups": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "allowAllAuthenticatedUsers": {"type": "boolean"}
      },
      "anyOf": [
        {"properties": {"requiredGroups": {"minItems": 1}}},
        {"properties": {"allowAllAuthenticatedUsers": {"const": true}}}
      ]
    },
    "flashCookie": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "existingSecretKey": {"type": "string", "minLength": 1},
        "key": {"type": "string"}
      },
      "anyOf": [
        {"properties": {"existingSecret": {"minLength": 1}}},
        {"properties": {"key": {"pattern": "^[A-Za-z0-9+/]{43}=$"}}}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["auth"],
        "properties": {
          "auth": {
            "required": ["mode"],
            "properties": {"mode": {"const": "native"}}
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "session": {
                "anyOf": [
                  {"required": ["existingSecret"], "properties": {"existingSecret": {"minLength": 1}}},
                  {"required": ["key"], "properties": {"key": {"pattern": "^[A-Za-z0-9+/]{43}=$"}}}
                ]
              }
            }
          },
          "oidc": {
            "anyOf": [
              {"required": ["existingSecret"], "properties": {"existingSecret": {"minLength": 1}}},
              {"required": ["clientSecret"], "properties": {"clientSecret": {"minLength": 1}}}
            ]
          }
        }
      }
    }
  ]
}
