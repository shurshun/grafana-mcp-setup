LISTEN_ADDR=127.0.0.1:8080
BASE_PATH=/setup-mcp
APP_PUBLIC_URL=https://mcp.example.com
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_PUBLIC_URL=https://grafana.example.com
GRAFANA_NAMESPACE=default
GRAFANA_API_MODE=legacy
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=grafana-mcp-setup
REQUIRED_GROUPS=/grafana-mcp
ALLOW_ALL_AUTHENTICATED_USERS=false
ID_TOKEN_SOURCE=header
ID_TOKEN_HEADER=X-Grafana-MCP-ID-Token
ROTATION_LOCK_MODE=local
TOKEN_TTL_DAYS=90
